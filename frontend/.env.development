# true  = run the frontend alone with sample content (no backend needed)
# false = use the real FastAPI backend (/api/login, /api/content, /api/media)
VITE_USE_MOCK=false

# Mock mode only — the password for local testing. The REAL password lives
# on the backend as a hash and is never in the frontend.
VITE_MOCK_PASSWORD=love

# Mock mode only — set true to preview how the Gift and London sections
# look before 13 October (sealed with a countdown).
VITE_MOCK_LOCKED=false

# Mock mode only — the code in the guest wish link (/wish?code=...).
# The real code is GUEST_CODE in backend/.env.
VITE_MOCK_GUEST_CODE=family2026

# Mock mode only — the secret code for your private voice note.
# The real one is VOICE_CODE in backend/.env.
VITE_MOCK_VOICE_CODE=1310
